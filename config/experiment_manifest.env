# Boosted trees use row/column subsampling and are stochastic once their run
# seed is correctly wired into the estimator.  They therefore belong in the
# same 25-seed small-sample stability roster as the neural/SSM arms.
EXP1_TREE_MODELS='xgboost lightgbm'
